{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/seed.ts",
    "typeorm": "typeorm",
    "migration:generate": "typeorm -- migration:generate ./src/migrations/Initial -d ./src/data-source.ts",
    "migration:run": "typeorm -- migration:run -d src/data-source.ts",
    "migration:revert": "typeorm -- migration:revert -d src/data-source.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "graphql": "^16.14.2",
    "graphql-scalars": "^1.25.0",
    "graphql-ws": "^6.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^2.0.0-rc.3",
    "typeorm": "^1.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
