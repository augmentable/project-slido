{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "deploy:preview": "vite build && wrangler deploy --config wrangler.preview.toml",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply slido-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply slido-db --remote",
    "db:seed": "wrangler d1 execute slido-db --local --file=seed-local.sql",
    "db:seed:prod": "npx tsx src/db/seed-remote.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apollo/client": "^4.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "hono": "^4.13.2",
    "jsonwebtoken": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
