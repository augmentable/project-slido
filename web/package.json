{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:cf": "npx @opennextjs/cloudflare build",
    "preview": "wrangler dev",
    "deploy": "npm run build:cf && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply slido-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply slido-db --remote",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:seed:prod": "npx tsx src/db/seed-remote.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.120.1"
  }
}
